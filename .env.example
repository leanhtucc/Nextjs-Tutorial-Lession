# PostgreSQL connection strings (e.g. from Vercel Postgres, Supabase, Neon, or local Postgres)
POSTGRES_URL="postgres://default:secret@ep-cool-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb"
POSTGRES_PRISMA_URL="postgres://default:secret@ep-cool-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:secret@ep-cool-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb"
POSTGRES_USER="default"
POSTGRES_HOST="ep-cool-sample.us-east-1.postgres.vercel-storage.com"
POSTGRES_PASSWORD="secret"
POSTGRES_DATABASE="verceldb"

# NextAuth v5 Secret (tạo bằng lệnh: openssl rand -base64 32)
AUTH_SECRET="your-32-character-secret-key-goes-here"
AUTH_URL="http://localhost:3000/api/auth"

# GitHub OAuth Provider (Tạo tại: https://github.com/settings/developers)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth Provider (Tạo tại: https://console.cloud.google.com/)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Danh sách email cấp quyền Admin khi đăng nhập OAuth (phân cách bởi dấu phẩy)
ADMIN_EMAILS="admin@nextmail.com"
